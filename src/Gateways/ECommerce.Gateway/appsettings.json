{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "orders-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "AuthenticatedUser"
      },
      "basket-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/v1/basket/{**catch-all}"
        },
        "AuthorizationPolicy": "AuthenticatedUser"
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/v1/inventory/{**catch-all}"
        },
        "AuthorizationPolicy": "AuthenticatedUser"
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        },
        "AuthorizationPolicy": "AuthenticatedUser"
      },
      "fulfillment-route": {
        "ClusterId": "fulfillment-cluster",
        "Match": {
          "Path": "/api/v1/fulfillment/{**catch-all}"
        },
        "AuthorizationPolicy": "AuthenticatedUser"
      },
      "iam-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/api/v1/iam/{**catch-all}"
        },
        "AuthorizationPolicy": "AuthenticatedUser"
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/v1/catalog/{**catch-all}"
        },
        "AuthorizationPolicy": "AuthenticatedUser"
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/v1/customers/{**catch-all}"
        },
        "AuthorizationPolicy": "AuthenticatedUser"
      },
      "search-route": {
        "ClusterId": "search-cluster",
        "Match": {
          "Path": "/api/v1/search/{**catch-all}"
        },
        "AuthorizationPolicy": "AuthenticatedUser"
      },
      "promotion-route": {
        "ClusterId": "promotion-cluster",
        "Match": {
          "Path": "/api/v1/promotion/{**catch-all}"
        },
        "AuthorizationPolicy": "AuthenticatedUser"
      },
      "audit-route": {
        "ClusterId": "audit-cluster",
        "Match": {
          "Path": "/api/v1/audit/{**catch-all}"
        },
        "AuthorizationPolicy": "AuthenticatedUser"
      }
    },
    "Clusters": {
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://order-api"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://inventory-api"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://payment-api"
          }
        }
      },
      "fulfillment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://fulfillment-api"
          }
        }
      },
      "iam-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://iam-api"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog-api"
          }
        }
      },
      "customer-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://customer-api"
          }
        }
      },
      "search-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://search-api"
          }
        }
      },
      "promotion-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://promotion-api"
          }
        }
      },
      "audit-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://audit-api"
          }
        }
      }
    }
  }
}
